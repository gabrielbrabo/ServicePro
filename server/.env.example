# Porta do servidor
PORT=3000

# Conexao com o MongoDB
# Local:  mongodb://127.0.0.1:27017/servicepro
# Atlas:  mongodb+srv://usuario:senha@cluster.mongodb.net/servicepro
MONGO_URI=mongodb://127.0.0.1:27017/servicepro

# Chave secreta para assinar os tokens JWT (troque por algo aleatorio e longo)
JWT_SECRET=troque-esta-chave-por-uma-string-aleatoria-bem-longa
JWT_EXPIRES_IN=7d

# URL do frontend (para o CORS e o Socket.IO)
CLIENT_URL=http://localhost:5173

# Assinatura digital (Clicksign) — deixe vazio para manter DESLIGADO (no-op)
# Token: painel Clicksign > Configuracoes > API > Gerar Access Token (admin)
CLICKSIGN_API_TOKEN=
# Sandbox (testes, sem valor juridico) ou producao (https://clicksign.com)
CLICKSIGN_BASE_URL=https://sandbox.clicksign.com
# Segredo gerado pelo Clicksign ao cadastrar o webhook (validacao HMAC)
CLICKSIGN_WEBHOOK_SECRET=
# email = token por e-mail (teste, sem certificado) | icp_brasil = certificado (producao)
CLICKSIGN_SIGN_AUTH=email

# ===== Gateway de pagamento (Asaas) =====
# Deixe PAYMENTS_PROVIDER vazio para rodar em modo no-op (dev, nada bloqueia).
# Para ativar o Asaas, use "asaas".
PAYMENTS_PROVIDER=
# Chave de API do Asaas ($aact_...). Sandbox: painel sandbox.asaas.com > Integracoes > Chave de API
ASAAS_API_KEY=
# Sandbox: https://api-sandbox.asaas.com/v3 | Producao: https://api.asaas.com/v3
ASAAS_BASE_URL=https://api-sandbox.asaas.com/v3
# Token que VOCE inventa e repete no webhook do Asaas (valida que o webhook e legitimo)
PAYMENTS_WEBHOOK_SECRET=
